<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>DeskBeam.Host</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>..\..\assets\DeskBeam.ico</ApplicationIcon>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishReadyToRun>false</PublishReadyToRun>
    </PropertyGroup>
	
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.6" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DeskBeam.Core\DeskBeam.Core.csproj" />
        <ProjectReference Include="..\DeskBeam.Engine\DeskBeam.Engine.csproj" />
        <AvaloniaResource Include="..\..\assets\DeskBeam.ico" Link="Assets\DeskBeam.ico" />
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
	    <DebugSymbols>False</DebugSymbols>
	    <DebugType>None</DebugType>
    </PropertyGroup>

</Project>
